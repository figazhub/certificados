rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function userDoc() {
      return /databases/$(database)/documents/usersByEmail/$(userEmail());
    }

    function authorized() {
      return signedIn() && exists(userDoc()) && validRole(get(userDoc()).data.role);
    }

    function profile() {
      return get(userDoc()).data;
    }

    function isAdmin() {
      return authorized() && profile().role == 'admin';
    }

    function validRole(role) {
      return role == 'professor' || role == 'admin';
    }

    // Mantém clientes em cache funcionando apenas durante o rollout do novo esquema.
    function legacyClientWindow() {
      return request.time < timestamp.date(2026, 10, 10);
    }

    function validUserProfile(email, data) {
      return data.keys().hasAll(['email', 'name', 'unit', 'role', 'updatedAt'])
        && data.keys().hasOnly(['email', 'name', 'graduation', 'unit', 'role', 'updatedAt'])
        && data.email == email
        && data.email is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && (!('graduation' in data) || (data.graduation is string && data.graduation.size() > 0 && data.graduation.size() <= 160))
        && data.unit is string
        && data.unit.size() > 0
        && data.unit.size() <= 160
        && validRole(data.role)
        && data.updatedAt == request.time;
    }

    function isBlackBelt(key) {
      return key == 'preta'
        || key == 'preta-1-grau'
        || key == 'preta-2-grau'
        || key == 'preta-3-grau'
        || key == 'preta-4-grau';
    }

    function isBlackBeltLabel(label) {
      return label == 'FAIXA PRETA'
        || label == 'FAIXA PRETA 1º GRAU'
        || label == 'FAIXA PRETA 2º GRAU'
        || label == 'FAIXA PRETA 3º GRAU'
        || label == 'FAIXA PRETA 4º GRAU';
    }

    function validBeltLabel(label) {
      return label in [
        'FAIXA CINZA E BRANCA', 'FAIXA CINZA', 'FAIXA CINZA E PRETA',
        'FAIXA AMARELA E BRANCA', 'FAIXA AMARELA', 'FAIXA AMARELA E PRETA',
        'FAIXA LARANJA E BRANCA', 'FAIXA LARANJA', 'FAIXA LARANJA E PRETA',
        'FAIXA VERDE E BRANCA', 'FAIXA VERDE', 'FAIXA VERDE E PRETA',
        'FAIXA AZUL', 'FAIXA ROXA', 'FAIXA MARROM', 'FAIXA PRETA',
        'FAIXA PRETA 1º GRAU', 'FAIXA PRETA 2º GRAU',
        'FAIXA PRETA 3º GRAU', 'FAIXA PRETA 4º GRAU'
      ];
    }

    function validBelt(key, label) {
      return (key == 'cinza-branca' && label == 'FAIXA CINZA E BRANCA')
        || (key == 'cinza' && label == 'FAIXA CINZA')
        || (key == 'cinza-preta' && label == 'FAIXA CINZA E PRETA')
        || (key == 'amarela-branca' && label == 'FAIXA AMARELA E BRANCA')
        || (key == 'amarela' && label == 'FAIXA AMARELA')
        || (key == 'amarela-preta' && label == 'FAIXA AMARELA E PRETA')
        || (key == 'laranja-branca' && label == 'FAIXA LARANJA E BRANCA')
        || (key == 'laranja' && label == 'FAIXA LARANJA')
        || (key == 'laranja-preta' && label == 'FAIXA LARANJA E PRETA')
        || (key == 'verde-branca' && label == 'FAIXA VERDE E BRANCA')
        || (key == 'verde' && label == 'FAIXA VERDE')
        || (key == 'verde-preta' && label == 'FAIXA VERDE E PRETA')
        || (key == 'azul' && label == 'FAIXA AZUL')
        || (key == 'roxa' && label == 'FAIXA ROXA')
        || (key == 'marrom' && label == 'FAIXA MARROM')
        || (key == 'preta' && label == 'FAIXA PRETA')
        || (key == 'preta-1-grau' && label == 'FAIXA PRETA 1º GRAU')
        || (key == 'preta-2-grau' && label == 'FAIXA PRETA 2º GRAU')
        || (key == 'preta-3-grau' && label == 'FAIXA PRETA 3º GRAU')
        || (key == 'preta-4-grau' && label == 'FAIXA PRETA 4º GRAU');
    }

    function validStudentLockKey(key) {
      return key is string
        && key.matches('^ALUNO-[A-Z0-9-]{1,180}$');
    }

    function studentIsNotLocked(data) {
      return !exists(/databases/$(database)/documents/rejectedStudentLocks/$(data.studentLockKey))
        || get(/databases/$(database)/documents/rejectedStudentLocks/$(data.studentLockKey)).data.lockUntil <= request.time;
    }

    function validCertificateCore(data) {
      return data.student is string
        && data.student.size() > 0
        && data.student.size() <= 160
        && data.studentUpper is string
        && data.studentUpper.size() > 0
        && data.studentUpper.size() <= 200
        && validStudentLockKey(data.studentLockKey)
        && data.beltKey is string
        && data.beltLabel is string
        && validBelt(data.beltKey, data.beltLabel)
        && (!('mainLogo' in data) || data.mainLogo in ['logo1', 'logo2', 'logo3'])
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.professors is list
        && data.professors.size() > 0
        && data.professors.size() <= 5
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000))
        && data.unit == profile().unit
        && data.issuerEmail == userEmail()
        && data.issuerName == profile().name
        && data.issuerRole == profile().role
        && data.requiresApproval == isBlackBelt(data.beltKey)
        && data.snapshot is string
        && data.snapshot.size() <= 10000
        && data.createdAt == request.time
        && studentIsNotLocked(data);
    }

    function validApprovedCreate(data) {
      return data.keys().hasAll([
          'student', 'studentUpper', 'studentLockKey', 'beltKey', 'beltLabel', 'date',
          'professors', 'unit', 'issuerEmail', 'issuerName', 'issuerRole',
          'status', 'requiresApproval', 'snapshot', 'authCode', 'createdAt',
          'approvedAt', 'approvedByEmail', 'approvedByName'
        ])
        && data.keys().hasOnly([
          'student', 'studentUpper', 'studentLockKey', 'beltKey', 'beltLabel', 'mainLogo', 'date',
          'professors', 'notes', 'unit', 'issuerEmail', 'issuerName', 'issuerRole',
          'status', 'requiresApproval', 'snapshot', 'authCode', 'createdAt',
          'approvedAt', 'approvedByEmail', 'approvedByName'
        ])
        && data.status == 'approved'
        && data.authCode is string
        && data.authCode.matches('^EXT-[0-9]{4}-[A-Z0-9]{6,32}$')
        && data.approvedAt == request.time
        && data.approvedByEmail == userEmail()
        && data.approvedByName == profile().name
        && (!isBlackBelt(data.beltKey) || isAdmin())
        && (existsAfter(/databases/$(database)/documents/publicCertificates/$(data.authCode))
          || legacyClientWindow());
    }

    function validPendingCreate(data) {
      return data.keys().hasAll([
          'student', 'studentUpper', 'studentLockKey', 'beltKey', 'beltLabel', 'date',
          'professors', 'unit', 'issuerEmail', 'issuerName', 'issuerRole',
          'status', 'requiresApproval', 'snapshot', 'authCode', 'createdAt', 'requestedAt'
        ])
        && data.keys().hasOnly([
          'student', 'studentUpper', 'studentLockKey', 'beltKey', 'beltLabel', 'mainLogo', 'date',
          'professors', 'notes', 'unit', 'issuerEmail', 'issuerName', 'issuerRole',
          'status', 'requiresApproval', 'snapshot', 'authCode', 'createdAt', 'requestedAt'
        ])
        && isBlackBelt(data.beltKey)
        && data.status == 'pending'
        && data.authCode == ''
        && data.requestedAt == request.time;
    }

    function validApproval(certId) {
      return resource.data.status == 'pending'
        && resource.data.requiresApproval == true
        && request.resource.data.status == 'approved'
        && request.resource.data.authCode is string
        && request.resource.data.authCode.matches('^EXT-[0-9]{4}-[A-Z0-9]{6,32}$')
        && request.resource.data.approvedAt == request.time
        && request.resource.data.approvedByEmail == userEmail()
        && request.resource.data.approvedByName == profile().name
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'authCode', 'approvedAt', 'approvedByEmail', 'approvedByName'
        ])
        && (legacyClientWindow()
          || (existsAfter(/databases/$(database)/documents/publicCertificates/$(request.resource.data.authCode))
            && getAfter(/databases/$(database)/documents/publicCertificates/$(request.resource.data.authCode)).data.certificateId == certId));
    }

    function validRejection(certId) {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'rejected'
        && request.resource.data.authCode == ''
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.rejectedByEmail == userEmail()
        && request.resource.data.rejectedByName == profile().name
        && request.resource.data.rejectedReason is string
        && request.resource.data.rejectedReason.size() > 0
        && request.resource.data.rejectedReason.size() <= 1000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'rejectedAt', 'rejectedByEmail', 'rejectedByName', 'rejectedReason', 'studentLockKey'
        ])
        && validStudentLockKey(request.resource.data.studentLockKey)
        && existsAfter(/databases/$(database)/documents/rejectedStudentLocks/$(request.resource.data.studentLockKey))
        && getAfter(/databases/$(database)/documents/rejectedStudentLocks/$(request.resource.data.studentLockKey)).data.certificateId == certId;
    }

    function validRejectedStudentLock(studentKey) {
      let data = request.resource.data;
      let certificate = getAfter(/databases/$(database)/documents/certificates/$(data.certificateId)).data;
      return data.keys().hasOnly(['certificateId', 'studentLockKey', 'studentUpper', 'rejectedAt', 'lockUntil'])
        && data.keys().hasAll(['certificateId', 'studentLockKey', 'studentUpper', 'rejectedAt', 'lockUntil'])
        && data.certificateId is string
        && existsAfter(/databases/$(database)/documents/certificates/$(data.certificateId))
        && certificate.status == 'rejected'
        && data.studentLockKey == studentKey
        && data.studentLockKey == certificate.studentLockKey
        && data.studentUpper == certificate.studentUpper
        && data.rejectedAt == request.time
        && data.lockUntil > request.time + duration.value(719, 'h')
        && data.lockUntil < request.time + duration.value(721, 'h');
    }

    function certificateAfter(certId) {
      return getAfter(/databases/$(database)/documents/certificates/$(certId)).data;
    }

    function validPublicCreate(authCode, data) {
      let cert = certificateAfter(data.certificateId);
      return data.keys().hasAll([
          'certificateId', 'authCode', 'student', 'beltLabel', 'date', 'professors',
          'unit', 'issuerName', 'approvedByName', 'status', 'issuedAt'
        ])
        && data.keys().hasOnly([
          'certificateId', 'authCode', 'student', 'beltLabel', 'date', 'professors',
          'unit', 'issuerName', 'approvedByName', 'status', 'issuedAt'
        ])
        && data.certificateId is string
        && existsAfter(/databases/$(database)/documents/certificates/$(data.certificateId))
        && data.authCode == authCode
        && data.authCode == cert.authCode
        && data.status == 'valid'
        && data.issuedAt == request.time
        && cert.status == 'approved'
        && data.student == cert.student
        && data.beltLabel == cert.beltLabel
        && data.date == cert.date
        && data.professors == cert.professors
        && data.unit == cert.unit
        && data.issuerName == cert.issuerName
        && data.approvedByName == cert.approvedByName;
    }

    function validLegacyPublicCreate(authCode, data) {
      return legacyClientWindow()
        && data.keys().hasAll([
          'authCode', 'student', 'beltLabel', 'date', 'professors', 'unit',
          'issuerEmail', 'issuerName', 'approvedByName', 'status', 'issuedAt'
        ])
        && data.keys().hasOnly([
          'authCode', 'student', 'beltLabel', 'date', 'professors', 'unit',
          'issuerEmail', 'issuerName', 'approvedByName', 'status', 'issuedAt'
        ])
        && data.authCode == authCode
        && data.authCode.matches('^EXT-[0-9]{4}-[A-Z0-9]{6,32}$')
        && data.student is string
        && data.student.size() > 0
        && validBeltLabel(data.beltLabel)
        && (!isBlackBeltLabel(data.beltLabel) || isAdmin())
        && data.professors is list
        && data.professors.size() > 0
        && data.professors.size() <= 5
        && (data.issuerEmail == userEmail() || isAdmin())
        && data.status == 'valid'
        && data.issuedAt == request.time;
    }

    function validRevocation() {
      return resource.data.status == 'valid'
        && request.resource.data.status == 'revoked'
        && request.resource.data.revokedAt == request.time
        && request.resource.data.revokedByEmail == userEmail()
        && request.resource.data.revokedByName == profile().name
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'revokedAt', 'revokedByEmail', 'revokedByName'
        ]);
    }

    match /usersByEmail/{email} {
      // Permite que uma conta recém-autenticada consulte apenas o próprio e-mail.
      // Assim o frontend diferencia corretamente perfil inexistente de uma falha de regra.
      allow get: if signedIn() && (email == userEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validUserProfile(email, request.resource.data);
      allow delete: if isAdmin();
    }

    match /certificates/{certId} {
      allow create: if authorized()
        && validCertificateCore(request.resource.data)
        && (validApprovedCreate(request.resource.data) || validPendingCreate(request.resource.data));

      allow read: if authorized()
        && (isAdmin() || resource.data.issuerEmail == userEmail());

      allow update: if isAdmin() && (validApproval(certId) || validRejection(certId));
      allow delete: if isAdmin();
    }

    match /rejectedStudentLocks/{studentKey} {
      allow get: if authorized();
      allow list: if false;
      allow create, update: if isAdmin() && validRejectedStudentLock(studentKey);
      allow delete: if isAdmin();
    }

    match /publicCertificates/{authCode} {
      allow get: if true;
      allow list: if false;
      allow create: if authorized()
        && (validPublicCreate(authCode, request.resource.data)
          || validLegacyPublicCreate(authCode, request.resource.data));
      allow update: if isAdmin() && validRevocation();
      allow delete: if isAdmin();
    }

    function validProfessorRequestCreate(data) {
      return data.keys().hasAll([
          'email', 'name', 'graduation', 'unit', 'status', 'requestedByEmail',
          'requestedByName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'email', 'name', 'graduation', 'unit', 'status', 'requestedByEmail',
          'requestedByName', 'createdAt'
        ])
        && data.email is string
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.email.size() <= 254
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 160
        && data.graduation is string
        && data.graduation.size() > 0
        && data.graduation.size() <= 160
        && data.unit is string
        && data.unit.size() > 0
        && data.unit.size() <= 160
        && data.status == 'pending'
        && data.requestedByEmail == userEmail()
        && data.requestedByName == profile().name
        && data.createdAt == request.time;
    }

    function validProfessorApproval() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && validRole(request.resource.data.approvedRole)
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedByEmail == userEmail()
        && request.resource.data.reviewedByName == profile().name
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'approvedRole', 'reviewedAt', 'reviewedByEmail', 'reviewedByName'
        ])
        && existsAfter(/databases/$(database)/documents/usersByEmail/$(resource.data.email))
        && getAfter(/databases/$(database)/documents/usersByEmail/$(resource.data.email)).data.email == resource.data.email
        && getAfter(/databases/$(database)/documents/usersByEmail/$(resource.data.email)).data.name == resource.data.name
        && getAfter(/databases/$(database)/documents/usersByEmail/$(resource.data.email)).data.graduation == resource.data.graduation
        && getAfter(/databases/$(database)/documents/usersByEmail/$(resource.data.email)).data.unit == resource.data.unit
        && getAfter(/databases/$(database)/documents/usersByEmail/$(resource.data.email)).data.role == request.resource.data.approvedRole;
    }

    function validProfessorRejection() {
      return resource.data.status == 'pending'
        && request.resource.data.status == 'rejected'
        && request.resource.data.rejectedReason is string
        && request.resource.data.rejectedReason.size() > 0
        && request.resource.data.rejectedReason.size() <= 1000
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedByEmail == userEmail()
        && request.resource.data.reviewedByName == profile().name
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'rejectedReason', 'reviewedAt', 'reviewedByEmail', 'reviewedByName'
        ]);
    }

    match /professorRequests/{requestId} {
      allow create: if authorized() && validProfessorRequestCreate(request.resource.data);
      allow read: if authorized()
        && (isAdmin() || resource.data.requestedByEmail == userEmail());
      allow update: if isAdmin()
        && (validProfessorApproval() || validProfessorRejection());
      allow delete: if isAdmin();
    }
  }
}

